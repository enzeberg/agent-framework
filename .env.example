# ============================================
# Agent Framework - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Model provider API keys (set at least one to enable real LLM calls)
# Without any key, the framework runs in mock mode automatically.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
